// Place your key bindings in this file to override the defaults
[
  {
    "key": "ctrl+n",
    "command": "explorer.newFile"
  },
  {
    "key": "ctrl+shift+n",
    "command": "explorer.newFolder"
  },
  {
    "key": "shift+cmd+[",
    "command": "-guid.insert",
    "when": "editorTextFocus"
  },
  { // Unbind unconditional default using "minus" (-) before command
    "key": "cmd+0",
    "command": "-workbench.action.focusSideBar"
  },
  { // Move focus to the SideBar if not (!) there
    "key": "cmd+0",
    "when": "!sideBarFocus",
    "command": "workbench.action.focusSideBar"
  },
  { // Move focus to the Editor, if currently in the SideBar
    "key": "cmd+0",
    "when": "sideBarFocus",
    "command": "workbench.action.focusActiveEditorGroup"
  },
  {
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\\\r\n"
    },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+e cmd+e",
    "command": "sqltools.executeCurrentQuery"
  },
  {
    "key": "shift+cmd+a",
    "command": "vscode-augment.focusAugmentPanel"
  },
  {
    "key": "ctrl+cmd+i",
    "command": "-vscode-augment.focusAugmentPanel"
  },
  {
    "key": "ctrl+cmd+i",
    "command": "-workbench.action.chat.open",
    "when": "!chatSetupDisabled && !chatSetupHidden"
  },
  {
    "key": "ctrl+cmd+i",
    "command": "-workbench.panel.chat",
    "when": "workbench.panel.chat.view.copilot.active"
  },
  {
    "key": "shift+cmd+i",
    "command": "-workbench.action.chat.openagent",
    "when": "config.chat.agent.enabled && !chatSetupDisabled && !chatSetupHidden"
  },
  {
    "key": "shift+cmd+a",
    "command": "workbench.view.extension.augment-chat"
  },
  {
    "key": "shift+cmd+a",
    "command": "-workbench.action.chat.focusConfirmation",
    "when": "accessibilityModeEnabled && chatIsEnabled"
  },
  {
    "key": "shift+cmd+a",
    "command": "-notification.acceptPrimaryAction",
    "when": "notificationFocus || notificationToastsVisible"
  },
  {
    "key": "tab",
    "command": "-vscode-augment.next-edit.background.accept",
    "when": "vscode-augment.enableNextEdit && vscode-augment.nextEdit.canAccept && activePanel == 'workbench.view.extension.augment-panel' || vscode-augment.enableNextEdit && vscode-augment.nextEdit.canAccept && activeViewlet == 'workbench.view.extension.augment-panel' || editorHoverFocused && vscode-augment.enableNextEdit && vscode-augment.nextEdit.canAccept && !suggestWidgetVisible || editorTextFocus && vscode-augment.enableNextEdit && vscode-augment.nextEdit.canAccept && !suggestWidgetVisible"
  }
]